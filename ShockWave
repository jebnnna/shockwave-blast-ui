-- blast logic
local function blast()
    local now = os.clock()
    if now - lastFire < cfg.cooldown then return end
    lastFire = now

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local origin = root.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local c = player.Character
        if not c then continue end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then continue end

        local dist = (hrp.Position - origin).Magnitude
        if dist > cfg.radius then continue end

        local falloff = 1 - (dist / cfg.radius) * 0.4
        local dir = (hrp.Position - origin)
        if dir.Magnitude < 0.1 then
            dir = Vector3.new(math.random()-0.5, 0, math.random()-0.5)
        end
        dir = dir.Unit

        hum.Sit = false
        hrp.AssemblyLinearVelocity = Vector3.new(
            dir.X * cfg.power * falloff,
            cfg.upward * falloff + cfg.power * 0.18,
            dir.Z * cfg.power * falloff
        )
    end
end

-- button press feedback + hold
local holding = false

blastBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        holding = true
        tween(blastBtn, 0.08, {BackgroundColor3 = Color3.fromRGB(70, 70, 70)})
        if not cfg.continuous then
            blast()
        end
    end
end)

blastBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        holding = false
        tween(blastBtn, 0.2, {BackgroundColor3 = Color3.fromRGB(38, 38, 38)})
    end
end)

RunService.Heartbeat:Connect(function()
    if holding and cfg.continuous and blasting == false then
        blast()
    end
end)

print("[Shockwave] ready")
