-- slider logic
local minP, maxP = 50, 800
local function setPower(scale)
    scale = math.clamp(scale, 0, 1)
    cfg.power = math.floor(minP + (maxP - minP) * scale)
    powerLabel.Text = "Power: " .. cfg.power
    fill.Size = UDim2.fromScale(scale, 1)
    knob.Position = UDim2.fromScale(scale, 0.5)
end
setPower(0.28)

local sliding = false
local function slideFromInput(input)
    local rel = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
    setPower(rel)
end

track.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        sliding = true
        slideFromInput(input)
    end
end)
track.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        sliding = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if sliding and input.UserInputType == Enum.UserInputType.Touch then
        slideFromInput(input)
    end
end)

